{
    "manufacturer": "Yihu",
    "keyboard_name": "minikeyboardmk3",
    "maintainer": "candlc3",
    "bootloader": "rp2040",
    "processor": "RP2040",
    "diode_direction": "COL2ROW",
    #define MATRIX_ROWS 3
    #define MATRIX_COLS 4

    #define MATRIX_ROW_PINS { GP8, GP6, GP7 }
    #define MATRIX_COL_PINS { GP0, GP1, GP2, GP9 }

	
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "oled": true
    },

    "matrix_pins": {
        "cols": ["GP0", "GP1", "GP2", "GP9"],
        "rows": ["GP8", "GP6", "GP7"]
    },

    "usb": {
        "vid": "0xFEED",
        "pid": "0x0000",
        "device_version": "1.0.0"
    },

    "url": "https://hackpad.hackclub.com",

    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [1, 3], "x": 3, "y": 1}
            ]
        }
    }
}